# CMake launches the CLI because C++20 has no standard subprocess API.
cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED BDSLC OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "BDSLC and TEST_DIR are required")
endif()
set(folder "${TEST_DIR}/中文 path")
file(MAKE_DIRECTORY "${folder}")
set(input "${folder}/技能.bdsl")
set(source [=[[skillset]("sample")->{[skill]("stick")->{[check]()->{}[declare]()->{}}}]=])
file(WRITE "${input}" "${source}")

function(run expected)
    execute_process(COMMAND "${BDSLC}" ${ARGN} INPUT_FILE "${input}"
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr RESULT_VARIABLE result TIMEOUT 10)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "bdslc ${ARGN}: expected ${expected}, got ${result}\n${stdout}\n${stderr}")
    endif()
    set(stdout "${stdout}" PARENT_SCOPE)
    set(stderr "${stderr}" PARENT_SCOPE)
endfunction()

run(0 --version)
if(NOT stdout STREQUAL "bdslc 1.0.0\n")
    message(FATAL_ERROR "Unexpected compiler version: ${stdout}")
endif()
run(0 --help)
run(0 --check --json -)
string(JSON count LENGTH "${stdout}" diagnostics)
if(NOT count EQUAL 0)
    message(FATAL_ERROR "Valid stdin has diagnostics")
endif()
run(0 --check --json "${input}")
run(0 "${input}")
set(output "${folder}/技能.cpp")
file(READ "${output}" previous)
if(NOT previous MATCHES "END\\(sample\\)")
    message(FATAL_ERROR "Default output missing generated skill set")
endif()
run(0 -)
if(NOT stdout STREQUAL previous)
    message(FATAL_ERROR "File and stdin generated different output")
endif()

# Compilation must not destroy source or an existing output on failure.
run(2 "${input}" -o "${input}")
file(READ "${input}" after)
if(NOT after STREQUAL source)
    message(FATAL_ERROR "Compilation overwrote input")
endif()
file(REMOVE "${folder}/alias.cpp")
file(CREATE_LINK "${input}" "${folder}/alias.cpp" RESULT link_result)
if(link_result STREQUAL "0")
    run(2 "${input}" -o "${folder}/alias.cpp")
    file(READ "${input}" after)
    if(NOT after STREQUAL source)
        message(FATAL_ERROR "Compilation overwrote input through a hard link")
    endif()
endif()
file(WRITE "${input}" "invalid")
run(1 "${input}")
file(READ "${output}" after)
if(NOT after STREQUAL previous)
    message(FATAL_ERROR "Invalid source truncated previous C++ output")
endif()
run(1 --check --json -)
string(JSON count LENGTH "${stdout}" diagnostics)
string(JSON severity GET "${stdout}" diagnostics 0 severity)
string(JSON line GET "${stdout}" diagnostics 0 line)
string(JSON column GET "${stdout}" diagnostics 0 column)
if(NOT count EQUAL 1 OR NOT severity STREQUAL "error" OR line LESS 1 OR column LESS 1)
    message(FATAL_ERROR "Invalid diagnostic JSON: ${stdout}")
endif()
run(1 --format -)
if(NOT stdout STREQUAL "")
    message(FATAL_ERROR "Invalid format produced output")
endif()

file(WRITE "${input}" "${source}")
foreach(style IN ITEMS "--indent;2" "--tabs")
    run(0 --format ${style} -)
    set(formatted "${stdout}")
    run(0 --format ${style} "${input}" -o "${folder}/formatted.bdsl")
    file(READ "${folder}/formatted.bdsl" saved)
    if(NOT saved STREQUAL formatted)
        message(FATAL_ERROR "Format stdout differs from file output")
    endif()
endforeach()
run(0 --format "${input}" -o "${input}")
run(0 --check "${input}")

run(2 --check --json "${folder}/missing.bdsl")
string(JSON error GET "${stdout}" error)
if(error STREQUAL "")
    message(FATAL_ERROR "Missing input has no JSON error")
endif()
run(2)
run(2 --unknown)
run(2 --indent)
run(2 --indent 0 -)
run(2 --indent 4junk -)
run(2 --indent 99999999999999999999999 -)
run(2 --check --format -)
run(2 --json -)
run(2 --check -o "${output}" -)
run(2 "${input}" "${input}")
message(STATUS "BDSL CLI contract checks passed")
